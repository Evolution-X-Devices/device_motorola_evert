<resources>

    <!-- Fingerprint -->
      <!-- Defines the location of the fingerprint sensor on the device
         0 = back
         1 = front
         2 = left side
         3 = right side
    -->
    <integer name="config_fingerprintSensorLocation">1</integer>
    <dimen name="fingerprint_dot_radius">5dp</dimen>
    <item name="fingerprint_sensor_location_fraction_y" type="fraction">95%</item>

    <bool name="config_is_front_facing_fps">true</bool>

</resources>
